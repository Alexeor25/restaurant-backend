# ─── Servidor ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Base de datos (PostgreSQL) ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ortuzar
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ─── JWT ────────────────────────────────────────────────────
